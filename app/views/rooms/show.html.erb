<div class="container mt-4" style="max-width: 75%;">

  <%# ---- Page header ---- %>
  <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
      <h3 class="fw-bold mb-0" style="color: #1a1f2e; font-size: 1.2rem;">
        <%= @room.name %>
      </h3>
      <p class="mb-0 mt-1" style="font-size: 0.8rem; color: #8a93a8;">Room details</p>
    </div>
    <%= link_to rooms_path,
        style: "font-size: 0.8rem; color: #5a6480; text-decoration: none;" do %>
      &#8592; All Rooms
    <% end %>
  </div>

  <%# ---- Room image card ---- %>
  <div class="mb-3" style="background:#fff; border-radius:10px;
       border:1px solid rgba(0,0,0,0.07); overflow:hidden;">

    <div class="d-flex align-items-center gap-2 px-4 py-3"
         style="border-bottom: 1px solid rgba(0,0,0,0.06);">
      <span style="width:8px; height:8px; border-radius:50%;
                   background:#4e9af1; display:inline-block;"></span>
      <h5 class="mb-0 fw-semibold" style="font-size:0.88rem; color:#1a1f2e;">
        Room image
      </h5>
    </div>

    <% if @room.image.attached? %>
      <%= image_tag url_for(@room.image),
      style: "width:100%; height:240px; object-fit:cover;" %>
    <% else %>
      <div class="d-flex flex-column align-items-center justify-content-center"
           style="height:200px; background:#f4f6fa;">
        <svg width="36" height="36" fill="none" viewBox="0 0 24 24"
             stroke="#c8cdd8" stroke-width="1.5" style="margin-bottom:8px;">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M2.25 21h19.5m-18-18v18m10.5-18v18m6-13.5V21M6.75
                   6.75h.75m-.75 3h.75m-.75 3h.75m3-6h.75m-.75 3h.75m-.75
                   3h.75M6.75 21v-3.375c0-.621.504-1.125 1.125-1.125h2.25c.621
                   0 1.125.504 1.125 1.125V21M3 3h12m-.75 4.5H21m-3.75
                   3.75h.008v.008h-.008v-.008zm0 3h.008v.008h-.008v-.008zm0
                   3h.008v.008h-.008v-.008z"/>
        </svg>
        <p class="mb-0" style="font-size:0.8rem; color:#8a93a8;">No image uploaded</p>
      </div>
    <% end %>

  </div>

  <%# ---- Room info card ---- %>
  <div class="mb-4" style="background:#fff; border-radius:10px;
       border:1px solid rgba(0,0,0,0.07); overflow:hidden;">

    <div class="d-flex align-items-center gap-2 px-4 py-3"
         style="border-bottom: 1px solid rgba(0,0,0,0.06);">
      <span style="width:8px; height:8px; border-radius:50%;
                   background:#639922; display:inline-block;"></span>
      <h5 class="mb-0 fw-semibold" style="font-size:0.88rem; color:#1a1f2e;">
        Room info
      </h5>
    </div>

    <div class="px-4 py-2">

      <div class="d-flex justify-content-between align-items-center py-3"
           style="border-bottom: 1px solid rgba(0,0,0,0.05); font-size:0.875rem;">
        <span style="color:#8a93a8;">Room name</span>
        <span class="fw-medium" style="color:#1a1f2e;"><%= @room.name %></span>
      </div>

      <div class="d-flex justify-content-between align-items-center py-3"
           style="border-bottom: 1px solid rgba(0,0,0,0.05); font-size:0.875rem;">
        <span style="color:#8a93a8;">Added on</span>
        <span class="fw-medium" style="color:#1a1f2e;">
          <%= @room.created_at.strftime("%B %d, %Y") %>
        </span>
      </div>

      <div class="d-flex justify-content-between align-items-center py-3"
           style="font-size:0.875rem;">
        <span style="color:#8a93a8;">Image</span>
        <% if @room.image.attached? %>
          <span style="background:#eaf3de; color:#3b6d11; font-size:0.72rem;
                       font-weight:500; padding:3px 10px; border-radius:20px;">
            Uploaded
          </span>
        <% else %>
          <span style="background:#faeeda; color:#633806; font-size:0.72rem;
                       font-weight:500; padding:3px 10px; border-radius:20px;">
            Not uploaded
          </span>
        <% end %>
      </div>

    </div>
  </div>

  <%# ---- Admin actions ---- %>
  <% if current_user.admin? %>
    <div class="d-flex gap-2">

      <%= link_to "Edit room", edit_room_path(@room),
          class: "btn fw-medium",
          style: "background:#4e9af1; color:#fff; border-radius:7px;
                  font-size:0.875rem; padding:8px 20px;" %>

      <%= button_to "Delete room", room_path(@room),
          method: :delete,
          data: { turbo_confirm: "Are you sure you want to delete #{@room.name}? This cannot be undone." },
          class: "btn fw-medium",
          style: "background:#fceaea; color:#7a1e1e; border:1px solid #f0b0b0;
                  border-radius:7px; font-size:0.875rem; padding:8px 20px;" %>

    </div>
  <% end %>

</div>