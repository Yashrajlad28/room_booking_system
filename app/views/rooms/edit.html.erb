<div class="container mt-4" style="max-width: 75%;">

  <!-- Header -->
  <div class="d-flex align-items-center justify-content-between mb-4">
    <div>
      <h3 class="fw-bold mb-0" style="color:#1a1f2e; font-size:1.2rem;">
        Edit Room
      </h3>
      <p style="font-size:0.8rem; color:#8a93a8;">Update room details</p>
    </div>

    <%= link_to rooms_path, style:"font-size:0.8rem; color:#5a6480;" do %>
      &#8592; Back
    <% end %>
  </div>

  <div style="background:#fff; border-radius:10px;
     border:1px solid rgba(0,0,0,0.07); overflow:hidden;">

    <div class="px-4 py-3 border-bottom">
      <h5 style="font-size:0.9rem;">Edit Details</h5>
    </div>

    <div class="px-4 py-3">

      <%= form_with model: @room do |f| %>

        <!-- Room Name -->
        <div class="mb-3">
          <%= f.label :name, class:"form-label" %>
          <%= f.text_field :name, class:"form-control" %>
        </div>

        <% if @room.image.attached? %>

          <div class="mb-3">
            <label class="form-label">Current Image</label>

            <div class="d-flex align-items-center gap-3">

              <%= image_tag url_for(@room.image),
                  style:"width:80px; height:80px; object-fit:cover; border-radius:6px;" %>

              <button type="button"
                      class="btn btn-sm btn-outline-primary"
                      data-bs-toggle="modal"
                      data-bs-target="#imageModal">
                View
              </button>

            </div>
          </div>

        <% end %>

        <div class="mb-3">
          <%= f.label :image, "Change Image", class:"form-label" %>
          <%= f.file_field :image, class:"form-control" %>
        </div>

        <div class="d-flex justify-content-end">
          <%= f.submit "Update Room",
              class:"btn",
              style:"background:#4e9af1; color:white;" %>
        </div>

      <% end %>

    </div>
  </div>
</div>

<div class="modal fade" id="imageModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered modal-lg">
    <div class="modal-content" style="border-radius:10px;">

      <div class="modal-header">
        <h5 class="modal-title">Room Image</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
      </div>

      <div class="modal-body text-center">

        <%= image_tag url_for(@room.image),
            style:"width:100%; max-height:400px; object-fit:contain;" %>

      </div>

    </div>
  </div>
</div>