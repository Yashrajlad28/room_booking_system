<h1>Edit this Booking</h1>
<%= form_with model: @booking do |f| %>
    <div>
        <%= f.label :booking_date %>
        <%= f.date_field :booking_date, value: @booking.booking_date %>
    </div>
    
    <div>
        <%= f.label :start_time %>
        <%= f.time_select :start_time, 
            { 
                start_hour: 10,
                end_hour: 22,
                minute_step: 15, 
                ignore_date: true,
                ampm: true
            },
            value: @booking.start_time %>
    </div>

    <div>
        <%= f.label :end_time %>
        <%= f.time_select :end_time,
            { 
                start_hour: 10,
                end_hour: 22,
                minute_step: 15, 
                ignore_date: true,
                ampm: true
            },
            value: @booking.end_time %>
    </div>

    <div>
        <%= f.submit "Edit" %>
    </div>
    
<% end %>
<%= link_to "Back", booking_path(@booking) %>