<%# ==========================================
    HOME PAGE — Welcome#index
    Sections: Hero | Stats | Features | CTA
    ========================================== %>

<%# ---- HERO ---- %>
<div class="row align-items-center g-5 py-3">

  <div class="col-lg-6">
    <span class="badge rounded-pill mb-3" style="background-color: #e6f1fb; color: #185fa5; font-size: 0.75rem; font-weight: 500; padding: 6px 14px;">
      <span style="display:inline-block; width:6px; height:6px; border-radius:50%; background:#4e9af1; margin-right:6px; vertical-align:middle;"></span>
      Room Booking System
    </span>

    <h1 class="display-5 fw-bold lh-sm mb-3" style="color: #1a1f2e;">
      Book Rooms<br>Effortlessly
    </h1>

    <p class="mb-4" style="color: #5a6480; font-size: 1rem; line-height: 1.75; max-width: 480px;">
      Find and reserve rooms instantly for meetings, events, or study sessions —
      with real-time availability and secure access.
    </p>

    <div class="d-flex gap-2 flex-wrap">
      <% if user_signed_in? %>
        <%= link_to "Book a Room", new_booking_path,
            class: "btn btn-sm fw-medium px-4 py-2",
            style: "background: #4e9af1; color: #fff; border-radius: 7px; font-size: 0.875rem;" %>
        <%= link_to "My Bookings", bookings_path,
            class: "btn btn-sm fw-medium px-4 py-2",
            style: "background: transparent; border: 1px solid #c8cdd8; color: #1a1f2e; border-radius: 7px; font-size: 0.875rem;" %>
      <% else %>

        <button class="btn btn-sm fw-medium px-4 py-2"
                data-bs-toggle="modal"
                data-bs-target="#registerModal"
                style="background: #4e9af1; color: #fff; border-radius: 7px; font-size: 0.875rem;">
          Get Started
        </button>

        <button class="btn btn-sm fw-medium px-4 py-2"
                data-bs-toggle="modal"
                data-bs-target="#loginModal"
                style="background: transparent; border: 1px solid #c8cdd8; color: #1a1f2e; border-radius: 7px; font-size: 0.875rem;">
          Login
        </button>
      <% end %>
    </div>
  </div>

  <div class="col-lg-6">
    <img src="https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?w=800&q=80"
         class="img-fluid"
         alt="A well-lit, professional meeting room"
         style="border-radius: 12px; object-fit: cover; max-height: 320px; width: 100%;">
  </div>

</div>

<%# ---- STATS ---- %>
<div class="row g-3 mt-2 mb-5">
  <div class="col-4">
    <div class="text-center p-3 bg-white rounded-3" style="border: 1px solid rgba(0,0,0,0.06);">
      <div class="fw-bold fs-4" style="color: #1a1f2e;">120+</div>
      <div style="font-size: 0.78rem; color: #8a93a8; margin-top: 2px;">Rooms available</div>
    </div>
  </div>
  <div class="col-4">
    <div class="text-center p-3 bg-white rounded-3" style="border: 1px solid rgba(0,0,0,0.06);">
      <div class="fw-bold fs-4" style="color: #1a1f2e;">500+</div>
      <div style="font-size: 0.78rem; color: #8a93a8; margin-top: 2px;">Bookings made</div>
    </div>
  </div>
  <div class="col-4">
    <div class="text-center p-3 bg-white rounded-3" style="border: 1px solid rgba(0,0,0,0.06);">
      <div class="fw-bold fs-4" style="color: #1a1f2e;">99%</div>
      <div style="font-size: 0.78rem; color: #8a93a8; margin-top: 2px;">Uptime reliability</div>
    </div>
  </div>
</div>

<%# ---- FEATURES ---- %>
<div class="text-center mb-4">
  <p class="text-uppercase fw-semibold mb-1" style="font-size: 0.72rem; letter-spacing: 0.07em; color: #8a93a8;">Why choose us</p>
  <h2 class="fw-bold" style="color: #1a1f2e; font-size: 1.4rem;">Everything you need to book a room</h2>
</div>

<div class="row g-3 mb-5">

  <div class="col-md-4">
    <div class="h-100 bg-white p-4 rounded-3" style="border: 1px solid rgba(0,0,0,0.06);">
      <div class="mb-3 d-flex align-items-center justify-content-center"
           style="width:42px; height:42px; border-radius:10px; background:#e6f1fb;">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none"
             viewBox="0 0 24 24" stroke="#185fa5" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z"/>
        </svg>
      </div>
      <h3 class="fw-semibold mb-2" style="font-size: 0.95rem; color: #1a1f2e;">Fast booking</h3>
      <p class="mb-0" style="font-size: 0.85rem; color: #6b7694; line-height: 1.65;">
        Reserve any room in seconds with a streamlined form designed to get you in quickly.
      </p>
    </div>
  </div>

  <div class="col-md-4">
    <div class="h-100 bg-white p-4 rounded-3" style="border: 1px solid rgba(0,0,0,0.06);">
      <div class="mb-3 d-flex align-items-center justify-content-center"
           style="width:42px; height:42px; border-radius:10px; background:#eaf3de;">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none"
             viewBox="0 0 24 24" stroke="#3b6d11" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 012.25-2.25h13.5A2.25 2.25 0 0121 7.5v11.25m-18 0A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75m-18 0v-7.5A2.25 2.25 0 015.25 9h13.5A2.25 2.25 0 0121 11.25v7.5"/>
        </svg>
      </div>
      <h3 class="fw-semibold mb-2" style="font-size: 0.95rem; color: #1a1f2e;">Real-time availability</h3>
      <p class="mb-0" style="font-size: 0.85rem; color: #6b7694; line-height: 1.65;">
        See which rooms are free right now and avoid double bookings automatically.
      </p>
    </div>
  </div>

  <div class="col-md-4">
    <div class="h-100 bg-white p-4 rounded-3" style="border: 1px solid rgba(0,0,0,0.06);">
      <div class="mb-3 d-flex align-items-center justify-content-center"
           style="width:42px; height:42px; border-radius:10px; background:#eeedfe;">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none"
             viewBox="0 0 24 24" stroke="#534ab7" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round"
                d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"/>
        </svg>
      </div>
      <h3 class="fw-semibold mb-2" style="font-size: 0.95rem; color: #1a1f2e;">Secure access</h3>
      <p class="mb-0" style="font-size: 0.85rem; color: #6b7694; line-height: 1.65;">
        Your bookings are tied to your account and protected with secure authentication.
      </p>
    </div>
  </div>

</div>

<%# ---- CTA BAND (only shown to guests) ---- %>
<% unless user_signed_in? %>
  <div class="text-center p-5 mb-4 rounded-3" style="background: #1a1f2e;">
    <h2 class="fw-bold mb-2" style="color: #fff; font-size: 1.4rem;">Ready to get started?</h2>
    <p class="mb-4" style="color: #8a93a8; font-size: 0.9rem;">
      Create an account and book your first room in under a minute.
    </p>
    <button class="btn fw-medium px-4 py-2"
          data-bs-toggle="modal"
          data-bs-target="#registerModal"
          style="background: #4e9af1; color: #fff; border-radius: 7px; font-size: 0.875rem;">
    Create a free account
  </button>
  </div>
<% end %>
